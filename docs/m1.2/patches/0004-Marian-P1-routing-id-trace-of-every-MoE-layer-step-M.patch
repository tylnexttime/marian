diff --git a/src/llama-moe-trace-ids.cpp b/src/llama-moe-trace-ids.cpp
new file mode 100644
index 000000000..6fa76e80e
--- /dev/null
+++ b/src/llama-moe-trace-ids.cpp
@@ -0,0 +1,180 @@
+#include "llama-moe-trace-ids.h"
+
+#include <algorithm>
+#include <chrono>
+#include <string>
+
+#if defined(_WIN32)
+#    ifndef WIN32_LEAN_AND_MEAN
+#        define WIN32_LEAN_AND_MEAN
+#    endif
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    include <windows.h>
+#else
+#    include <cerrno>
+#    include <fcntl.h>
+#    include <unistd.h>
+#endif
+
+static void llama_moe_ids_put(std::vector<uint8_t> & v, uint64_t x, int n) {
+    for (int i = 0; i < n; ++i) {
+        v.push_back((uint8_t) (x >> (8*i)));
+    }
+}
+
+llama_moe_ids_writer::llama_moe_ids_writer(const char * path, int64_t t_open_us, int64_t flush_ms) : flush_ms(flush_ms) {
+    if (!open_file(path)) {
+        return;
+    }
+    std::vector<uint8_t> h = { 'M', 'R', 'N', 'I', 'D', 'S', '1', '\n' };
+    llama_moe_ids_put(h, header_bytes, 4);
+    llama_moe_ids_put(h, version, 4);
+    llama_moe_ids_put(h, 2, 4); // id_bytes
+    llama_moe_ids_put(h, 0, 4); // reserved
+    llama_moe_ids_put(h, (uint64_t) t_open_us, 8);
+    if (!write_all(h.data(), h.size())) {
+        close_file();
+        return;
+    }
+    cur.reserve(2*hiwater);
+    out.reserve(2*hiwater);
+    thread = std::thread([this] () { run(); });
+}
+
+llama_moe_ids_writer::~llama_moe_ids_writer() {
+    if (thread.joinable()) {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv.notify_one();
+        thread.join();
+    }
+    if (is_open) {
+        flush();
+    }
+    close_file();
+}
+
+void llama_moe_ids_writer::record(char kind, int32_t layer, int64_t t_us, int64_t n_tokens, int64_t k, const int32_t * ids,
+        int64_t row_stride, int64_t col_stride) {
+    std::lock_guard<std::mutex> lk(m);
+    llama_moe_ids_put(cur, (uint8_t) kind, 1);
+    llama_moe_ids_put(cur, (uint64_t) std::clamp<int64_t>(k, 0, 255), 1);
+    llama_moe_ids_put(cur, (uint64_t) std::clamp<int64_t>(layer, 0, 65535), 2);
+    llama_moe_ids_put(cur, (uint64_t) n_tokens, 4);
+    llama_moe_ids_put(cur, (uint64_t) t_us, 8);
+    for (int64_t r = 0; r < n_tokens; ++r) {
+        for (int64_t j = 0; j < k; ++j) {
+            const int32_t id = ids[r*row_stride + j*col_stride];
+            llama_moe_ids_put(cur, id >= 0 && id < 0xffff ? (uint64_t) id : 0xffffu, 2);
+        }
+    }
+    n_records++;
+    if (cur.size() >= hiwater) {
+        cv.notify_one();
+    }
+}
+
+void llama_moe_ids_writer::flush() {
+    std::lock_guard<std::mutex> lf(mf);
+    {
+        std::lock_guard<std::mutex> lk(m);
+        out.swap(cur);
+    }
+    write_out();
+}
+
+uint64_t llama_moe_ids_writer::records() const {
+    std::lock_guard<std::mutex> lk(m);
+    return n_records;
+}
+
+void llama_moe_ids_writer::run() {
+    std::unique_lock<std::mutex> lk(m);
+    while (!stop) {
+        cv.wait_for(lk, std::chrono::milliseconds(flush_ms), [this] () { return stop || cur.size() >= hiwater; });
+        if (stop) {
+            break;
+        }
+        lk.unlock();
+        flush(); // the file lock, then the buffer lock: the order of every caller
+        lk.lock();
+    }
+}
+
+void llama_moe_ids_writer::write_out() {
+    if (!out.empty()) {
+        if (!write_all(out.data(), out.size())) {
+            n_failed++;
+        }
+        out.clear();
+    }
+}
+
+#if defined(_WIN32)
+bool llama_moe_ids_writer::open_file(const char * path) {
+    const int n = MultiByteToWideChar(CP_UTF8, 0, path, -1, nullptr, 0);
+    std::wstring w(n > 0 ? n : 1, L'\0');
+    if (n > 0) {
+        MultiByteToWideChar(CP_UTF8, 0, path, -1, &w[0], n);
+    }
+    HANDLE h = CreateFileW(w.c_str(), GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    is_open = h != INVALID_HANDLE_VALUE;
+    handle  = is_open ? (intptr_t) h : -1;
+    return is_open;
+}
+
+bool llama_moe_ids_writer::write_all(const uint8_t * p, size_t n) {
+    while (n > 0) {
+        DWORD done = 0;
+        const DWORD chunk = (DWORD) std::min<size_t>(n, (size_t) 1 << 30);
+        if (!WriteFile((HANDLE) handle, p, chunk, &done, nullptr) || done == 0) {
+            return false;
+        }
+        p += done;
+        n -= done;
+    }
+    return true;
+}
+
+void llama_moe_ids_writer::close_file() {
+    if (handle != -1) {
+        CloseHandle((HANDLE) handle);
+        handle = -1;
+    }
+    is_open = false;
+}
+#else
+bool llama_moe_ids_writer::open_file(const char * path) {
+    const int fd = ::open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    is_open = fd >= 0;
+    handle  = fd;
+    return is_open;
+}
+
+bool llama_moe_ids_writer::write_all(const uint8_t * p, size_t n) {
+    while (n > 0) {
+        const ssize_t done = ::write((int) handle, p, n);
+        if (done < 0 && errno == EINTR) {
+            continue;
+        }
+        if (done <= 0) {
+            return false;
+        }
+        p += done;
+        n -= (size_t) done;
+    }
+    return true;
+}
+
+void llama_moe_ids_writer::close_file() {
+    if (handle >= 0) {
+        ::close((int) handle);
+        handle = -1;
+    }
+    is_open = false;
+}
+#endif
diff --git a/src/llama-moe-trace-ids.h b/src/llama-moe-trace-ids.h
new file mode 100644
index 000000000..adc0591f7
--- /dev/null
+++ b/src/llama-moe-trace-ids.h
@@ -0,0 +1,87 @@
+#pragma once
+
+// Marian P1: routing-id trace of the MoE layers (MARIAN_MOE_TRACE_IDS=<file>), off unless the variable names a file.
+//
+// Every MoE layer step whose expert ids reach the host is recorded with all of its routed ids, hits included: the
+// slot-map lookups of the MoE cache (kind 'S', ubatches up to 32 tokens) and the large-batch selective copies (kind
+// 'L', one record per layer and ubatch, written when the copy reads the ids). t_us and the layer equal those of the
+// step's S line, or of the first L line of the layer, in MARIAN_MOE_TRACE, so the two traces join exactly.
+//
+// File format, little-endian, packed (no padding):
+//   header, 32 bytes:
+//     char[8] magic        "MRNIDS1\n"
+//     u32     header_bytes 32 (a reader skips to this offset, so fields can be added)
+//     u32     version      1
+//     u32     id_bytes     2 (ids are u16)
+//     u32     reserved     0
+//     i64     t_open_us    steady clock at open, the clock of t_us (microseconds)
+//   records, until the end of the file (a last record cut short by a kill is ignored by readers):
+//     u8      kind         'S' (0x53) slot-map lookup, 'L' (0x4c) large-batch copy
+//     u8      k            ids per row (ne[0] of the selected-experts tensor, n_expert_used)
+//     u16     layer
+//     u32     n_tokens     rows (tokens of the ubatch)
+//     i64     t_us         steady clock, microseconds
+//     u16     ids[n_tokens*k]  row by row, each row in the router's order; 0xffff = an id that does not fit in u16
+//   A single-token decode step of a model with 10 experts per token takes 16 + 20 = 36 bytes.
+//
+// The trace never changes a computation: it copies ids the host has already read. Records go to a memory buffer; a
+// writer thread moves the buffer to the file every flush_ms milliseconds (or when it passes 1 MiB), so the compute
+// thread never waits on the disk. The file is written with the OS file API, not stdio, so the C runtime's exit-time
+// stream cleanup never touches it while the thread runs. A killed server loses at most the last flush_ms of records.
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class llama_moe_ids_writer {
+public:
+    static constexpr uint32_t header_bytes = 32;
+    static constexpr uint32_t version      = 1;
+    static constexpr uint32_t record_bytes = 16; // before the ids
+
+    // opens (truncates) path and writes the header; ok() is false if that failed
+    llama_moe_ids_writer(const char * path, int64_t t_open_us, int64_t flush_ms = 100);
+    // stops the writer thread, writes what is buffered and closes the file
+    ~llama_moe_ids_writer();
+
+    llama_moe_ids_writer(const llama_moe_ids_writer &) = delete;
+    llama_moe_ids_writer & operator=(const llama_moe_ids_writer &) = delete;
+
+    bool ok() const { return is_open; }
+
+    // one step: n_tokens rows of k ids; the id of row r, rank j is ids[r*row_stride + j*col_stride] (int32 elements)
+    void record(char kind, int32_t layer, int64_t t_us, int64_t n_tokens, int64_t k, const int32_t * ids,
+                int64_t row_stride, int64_t col_stride);
+
+    // everything recorded so far is in the file when this returns
+    void flush();
+
+    uint64_t records() const;
+    uint64_t failed_writes() const { return n_failed.load(); }
+
+private:
+    static constexpr size_t hiwater = 1 << 20;
+
+    void run();
+    void write_out(); // caller holds mf
+    bool open_file(const char * path);
+    bool write_all(const uint8_t * p, size_t n);
+    void close_file();
+
+    intptr_t handle = -1; // HANDLE on Windows, a file descriptor elsewhere
+    const int64_t flush_ms;
+    bool is_open = false;
+
+    mutable std::mutex m;      // cur, stop, n_records
+    std::mutex mf;             // the file and out; always taken before m
+    std::condition_variable cv;
+    std::vector<uint8_t> cur;  // filled by record()
+    std::vector<uint8_t> out;  // being written
+    bool stop = false;
+    uint64_t n_records = 0;
+    std::atomic<uint64_t> n_failed{0};
+    std::thread thread;
+};
