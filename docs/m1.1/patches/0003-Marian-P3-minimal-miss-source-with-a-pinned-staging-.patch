diff --git a/src/llama-moe-source.cpp b/src/llama-moe-source.cpp
new file mode 100644
index 00000000..7a0a13da
--- /dev/null
+++ b/src/llama-moe-source.cpp
@@ -0,0 +1,621 @@
+#include "llama-moe-source.h"
+
+#include "llama-impl.h"
+
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+
+#if defined(_WIN32)
+#    ifndef WIN32_LEAN_AND_MEAN
+#        define WIN32_LEAN_AND_MEAN
+#    endif
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    include <windows.h>
+#else
+#    include <cerrno>
+#    include <fcntl.h>
+#    include <sys/stat.h>
+#    include <unistd.h>
+#endif
+
+namespace {
+
+constexpr int      moe_source_queue_depth  = 16;  // reads in flight (one per expert tensor)
+constexpr uint16_t moe_source_decay_period = 256; // decode steps of a layer between two halvings of its counts
+
+uint64_t moe_round_up(uint64_t x, uint64_t a) {
+    return (x + a - 1)/a*a;
+}
+
+#if defined(_WIN32)
+std::wstring moe_utf8_to_wide(const std::string & s) {
+    const int n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, nullptr, 0);
+    std::wstring w(n > 0 ? n - 1 : 0, L'\0');
+    if (n > 1) {
+        MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, &w[0], n);
+    }
+    return w;
+}
+#endif
+
+}
+
+struct llama_moe_source::impl {
+    struct file {
+#if defined(_WIN32)
+        HANDLE h = INVALID_HANDLE_VALUE;
+#else
+        int fd = -1;
+#endif
+        bool direct = false;
+    };
+
+    struct read_op {
+#if defined(_WIN32)
+        OVERLAPPED ov;
+        HANDLE     ev;
+#endif
+        int32_t         file;
+        uint64_t        aoff;     // sector-aligned file offset
+        uint8_t       * buf;      // sector-aligned region
+        uint32_t        skip;     // the payload starts at buf + skip
+        uint32_t        len;      // payload bytes (one expert of one tensor)
+        uint32_t        alen;     // bytes read, a multiple of the sector size
+        ggml_tensor   * bank;     // upload target, nullptr: read only (verification)
+        size_t          bank_off;
+        const uint8_t * host;     // the same bytes in the host tensor
+        int32_t         tier_g;   // the tier slot being filled, -1 for the ring
+        int32_t         tier_s;
+    };
+
+    struct tier {
+        size_t                 slot_bytes = 0;
+        int32_t                n_slots    = 0;
+        std::vector<uint8_t *> base; // [n_slots]
+        std::vector<int32_t>   key;  // [n_slots] il*n_expert + e, -1 if free
+        std::vector<uint8_t>   ref;  // CLOCK reference bits
+        std::vector<uint32_t>  busy; // generation in which the slot was last read into or uploaded from
+        int32_t                hand = 0;
+    };
+
+    int32_t type;
+    int32_t n_expert;
+    bool    verify_all = false;
+
+    std::vector<file> files;
+    uint64_t sector = 0;
+
+    std::vector<std::vector<llama_moe_source_tensor>> layers;
+    std::vector<std::vector<size_t>> region_off; // [n_layer][tensor] offset of each tensor's region in a slot
+    std::vector<int32_t> group_of;
+
+    std::vector<ggml_backend_buffer_ptr> bufs; // pinned memory of the ring and the tier
+    size_t pinned_bytes   = 0;
+    size_t pageable_bytes = 0;
+
+    uint8_t * ring      = nullptr;
+    size_t    ring_slot = 0;
+    int32_t   ring_n    = 0;
+    int32_t   ring_next = 0;
+
+    std::vector<tier>                  tiers;     // [n_group], empty for type RING
+    std::vector<std::vector<int32_t>>  tier_slot; // [n_layer][n_expert] slot in the group's tier, -1
+    std::vector<std::vector<uint16_t>> count;     // [n_layer][n_expert] decayed selections in decode steps
+    std::vector<uint16_t>              n_decode;  // [n_layer] decode steps since the last halving
+
+    std::deque<read_op> queue;
+#if defined(_WIN32)
+    std::vector<HANDLE> free_ev;
+#endif
+
+    uint32_t gen    = 1;
+    int32_t  il     = -1;
+    bool     decode = false;
+
+    // stats
+    size_t n_tier = 0, n_admit = 0, n_ring = 0, n_fail = 0, n_wrap = 0, n_mismatch = 0;
+    size_t bytes_read = 0, step_read = 0;
+
+    // set when the source cannot be used; no exception is thrown, since this build may not unwind (no /EHsc)
+    std::string error;
+
+    uint64_t region(uint64_t nb2) const {
+        return moe_round_up(nb2, sector) + sector; // an aligned read of nb2 bytes at any offset fits
+    }
+
+    // pinned host memory, sector-aligned; the host buffer type itself falls back to pageable memory, which is counted
+    uint8_t * alloc(ggml_backend_buffer_type_t host_buft, size_t size) {
+        ggml_backend_buffer_ptr buf(ggml_backend_buft_alloc_buffer(host_buft, size + sector));
+        if (!buf) {
+            error = format("cannot allocate %.2f MiB of host memory", size/1024.0/1024.0);
+            return nullptr;
+        }
+        if (ggml_backend_buffer_get_type(buf.get()) == host_buft) {
+            pinned_bytes += size;
+        } else {
+            pageable_bytes += size;
+        }
+        uint8_t * base = (uint8_t *) ggml_backend_buffer_get_base(buf.get());
+        uint8_t * res  = (uint8_t *) (moe_round_up((uintptr_t) base, sector));
+        bufs.push_back(std::move(buf));
+        return res;
+    }
+
+    bool open_files(const std::vector<std::string> & paths) {
+        for (const std::string & path : paths) {
+            file f;
+#if defined(_WIN32)
+            const std::wstring wpath = moe_utf8_to_wide(path);
+            f.h = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                              FILE_FLAG_NO_BUFFERING | FILE_FLAG_OVERLAPPED, nullptr);
+            f.direct = f.h != INVALID_HANDLE_VALUE;
+            if (!f.direct) {
+                LLAMA_LOG_WARN("llama_moe_source: unbuffered open of %s failed (error %lu), reading it through the OS cache\n", path.c_str(), GetLastError());
+                f.h = CreateFileW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, nullptr);
+            }
+            if (f.h == INVALID_HANDLE_VALUE) {
+                error = format("cannot open %s (error %lu)", path.c_str(), GetLastError());
+                return false;
+            }
+            // the sector size is queried, not assumed (design C-14)
+            FILE_STORAGE_INFO si = {};
+            if (GetFileInformationByHandleEx(f.h, FileStorageInfo, &si, sizeof(si))) {
+                const uint64_t sec = std::max<uint64_t>(si.LogicalBytesPerSector, si.PhysicalBytesPerSectorForPerformance);
+                if (sec > 0 && (sec & (sec - 1)) == 0) {
+                    sector = std::max(sector, sec);
+                }
+            } else {
+                LLAMA_LOG_WARN("llama_moe_source: sector size query failed for %s (error %lu), using 4096\n", path.c_str(), GetLastError());
+            }
+#else
+#    if defined(__linux__) && defined(O_DIRECT)
+            f.fd = open(path.c_str(), O_RDONLY | O_DIRECT);
+            f.direct = f.fd >= 0;
+            if (!f.direct) {
+                LLAMA_LOG_WARN("llama_moe_source: O_DIRECT open of %s failed (%s), reading it through the OS cache\n", path.c_str(), strerror(errno));
+            }
+#    endif
+            if (f.fd < 0) {
+                f.fd = open(path.c_str(), O_RDONLY);
+            }
+            if (f.fd < 0) {
+                error = format("cannot open %s: %s", path.c_str(), strerror(errno));
+                return false;
+            }
+#    if defined(__APPLE__)
+            fcntl(f.fd, F_NOCACHE, 1);
+#    endif
+            // a multiple of the usual 512 and 4096 byte logical blocks
+            sector = std::max<uint64_t>(sector, 4096);
+#endif
+            files.push_back(f);
+        }
+        if (sector == 0) {
+            sector = 4096;
+        }
+#if defined(_WIN32)
+        for (int i = 0; i < moe_source_queue_depth; ++i) {
+            HANDLE ev = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+            if (ev == nullptr) {
+                error = "cannot create the read events";
+                return false;
+            }
+            free_ev.push_back(ev);
+        }
+#endif
+        return true;
+    }
+
+    ~impl() {
+        drain(nullptr);
+#if defined(_WIN32)
+        for (HANDLE ev : free_ev) {
+            CloseHandle(ev);
+        }
+        for (const file & f : files) {
+            if (f.h != INVALID_HANDLE_VALUE) {
+                CloseHandle(f.h);
+            }
+        }
+#else
+        for (const file & f : files) {
+            if (f.fd >= 0) {
+                close(f.fd);
+            }
+        }
+#endif
+    }
+
+    void invalidate(int32_t g, int32_t s) {
+        tier & t = tiers[g];
+        const int32_t k = t.key[s];
+        if (k >= 0) {
+            tier_slot[k/n_expert][k%n_expert] = -1;
+            t.key[s] = -1;
+        }
+    }
+
+    // the read r has finished (ok) or failed: check it, then upload the expert's bytes of this tensor
+    void finish(ggml_backend_t backend, read_op & r, bool ok) {
+        if (ok) {
+            bytes_read += r.alen;
+            step_read  += r.alen;
+            if ((verify_all || r.bank == nullptr) && std::memcmp(r.buf + r.skip, r.host, r.len) != 0) {
+                n_mismatch++;
+                if (r.bank != nullptr) {
+                    // never compute with bytes that differ from the model's
+                    GGML_ABORT("llama_moe_source: bytes read at offset %llu differ from the memory map", (unsigned long long) (r.aoff + r.skip));
+                }
+            }
+        } else {
+            if (n_fail++ == 0) {
+                LLAMA_LOG_WARN("llama_moe_source: a read at offset %llu failed, the expert is uploaded from the memory map instead (counted)\n",
+                    (unsigned long long) r.aoff);
+            }
+            if (r.tier_g >= 0) {
+                invalidate(r.tier_g, r.tier_s);
+            }
+        }
+        if (r.bank != nullptr && backend != nullptr) {
+            ggml_backend_tensor_set_async(backend, r.bank, ok ? r.buf + r.skip : r.host, r.bank_off, r.len);
+        }
+    }
+
+    void complete_oldest(ggml_backend_t backend) {
+        read_op & r = queue.front();
+#if defined(_WIN32)
+        DWORD n = 0;
+        const bool ok = GetOverlappedResult(files[r.file].h, &r.ov, &n, TRUE) && n >= r.skip + r.len;
+        free_ev.push_back(r.ev);
+#else
+        const bool ok = true; // POSIX reads complete in submit
+#endif
+        finish(backend, r, ok);
+        queue.pop_front();
+    }
+
+    void drain(ggml_backend_t backend) {
+        while (!queue.empty()) {
+            complete_oldest(backend);
+        }
+    }
+
+    void submit(ggml_backend_t backend, const llama_moe_source_tensor & t, int32_t e, uint8_t * region,
+                ggml_tensor * bank, size_t bank_off, int32_t tier_g, int32_t tier_s) {
+        const uint64_t off = t.offset + (uint64_t) e*t.nb2;
+        read_op r = {};
+        r.file     = t.file;
+        r.aoff     = off/sector*sector;
+        r.buf      = region;
+        r.skip     = (uint32_t) (off - r.aoff);
+        r.len      = (uint32_t) t.nb2;
+        r.alen     = (uint32_t) moe_round_up(r.skip + t.nb2, sector);
+        r.bank     = bank;
+        r.bank_off = bank_off;
+        r.host     = (const uint8_t *) t.host->data + (size_t) e*t.nb2;
+        r.tier_g   = tier_g;
+        r.tier_s   = tier_s;
+#if defined(_WIN32)
+        if ((int) queue.size() >= moe_source_queue_depth) {
+            complete_oldest(backend);
+        }
+        r.ev = free_ev.back();
+        free_ev.pop_back();
+        r.ov.Offset     = (DWORD) (r.aoff & 0xffffffffull);
+        r.ov.OffsetHigh = (DWORD) (r.aoff >> 32);
+        r.ov.hEvent     = r.ev;
+        queue.push_back(r);
+        read_op & q = queue.back(); // std::deque keeps the address of q (and of its OVERLAPPED) until it is popped
+        if (!ReadFile(files[q.file].h, q.buf, q.alen, nullptr, &q.ov) && GetLastError() != ERROR_IO_PENDING) {
+            free_ev.push_back(q.ev);
+            read_op failed = q;
+            queue.pop_back();
+            finish(backend, failed, false);
+        }
+#else
+        size_t done = 0;
+        bool ok = true;
+        while (done < r.alen) {
+            const ssize_t n = pread(files[r.file].fd, r.buf + done, r.alen - done, (off_t) (r.aoff + done));
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            if (n <= 0) {
+                break; // end of file or error
+            }
+            done += (size_t) n;
+        }
+        ok = done >= r.skip + r.len;
+        finish(backend, r, ok);
+#endif
+    }
+
+    // read expert e of the current layer into region, then upload each tensor to slot s
+    void read_expert(ggml_backend_t backend, int32_t e, int32_t s, uint8_t * slot, int32_t tier_g, int32_t tier_s) {
+        const auto & ts  = layers[il];
+        const auto & off = region_off[il];
+        for (size_t k = 0; k < ts.size(); ++k) {
+            submit(backend, ts[k], e, slot + off[k], ts[k].bank, (size_t) s*ts[k].nb2, tier_g, tier_s);
+        }
+    }
+
+    // CLOCK over the group's tier, skipping slots in use in this step; a free slot is taken at once, otherwise the
+    // newcomer is admitted only if it was selected more often than the expert it would replace (TinyLFU-style)
+    int32_t victim(tier & t, int32_t e) {
+        for (int32_t i = 0; i < 2*t.n_slots; ++i) {
+            const int32_t s = t.hand;
+            t.hand = (t.hand + 1) % t.n_slots;
+            if (t.busy[s] == gen) {
+                continue;
+            }
+            if (t.key[s] < 0) {
+                return s;
+            }
+            if (t.ref[s]) {
+                t.ref[s] = 0;
+                continue;
+            }
+            const int32_t k = t.key[s];
+            return count[il][e] > count[k/n_expert][k%n_expert] ? s : -1;
+        }
+        return -1;
+    }
+};
+
+llama_moe_source::llama_moe_source(const llama_moe_source_params & params, ggml_backend_buffer_type_t host_buft,
+        const std::vector<std::string> & files,
+        const std::vector<std::vector<llama_moe_source_tensor>> & layers,
+        const std::vector<int32_t> & group_of, const std::vector<size_t> & group_bytes, int32_t n_expert) : pimpl(new impl()) {
+    impl & p = *pimpl;
+    p.type     = params.type;
+    p.n_expert = n_expert;
+    p.layers   = layers;
+    p.group_of = group_of;
+
+    const char * verify = std::getenv("MARIAN_MOE_SOURCE_VERIFY");
+    p.verify_all = verify != nullptr && std::strcmp(verify, "all") == 0;
+    const bool verify_load = verify == nullptr || std::strcmp(verify, "0") != 0;
+
+    // on failure: keep the reason, free the pinned memory, and leave the object inert (the caller drops it)
+    auto fail = [&p](const std::string & why) {
+        if (p.error.empty()) {
+            p.error = why;
+        }
+        p.drain(nullptr);
+        p.tiers.clear();
+        p.bufs.clear();
+        p.ring = nullptr;
+    };
+
+    if (host_buft == nullptr) {
+        fail("the device has no pinned host buffer type");
+        return;
+    }
+    if (!p.open_files(files)) {
+        fail(p.error);
+        return;
+    }
+
+    // the slot of each layer: one sector-aligned region per expert tensor
+    const size_t n_group = group_bytes.size();
+    std::vector<size_t> group_slot(n_group, 0);
+    std::vector<int32_t> group_layers(n_group, 0);
+    p.region_off.resize(layers.size());
+    for (size_t il = 0; il < layers.size(); ++il) {
+        size_t b = 0;
+        for (const auto & t : layers[il]) {
+            p.region_off[il].push_back(b);
+            b += p.region(t.nb2);
+        }
+        p.ring_slot = std::max(p.ring_slot, b);
+        if (group_of[il] >= 0) {
+            group_slot[group_of[il]] = std::max(group_slot[group_of[il]], b);
+            group_layers[group_of[il]]++;
+        }
+    }
+    if (p.ring_slot == 0) {
+        fail("no cached layer");
+        return;
+    }
+
+    const size_t ring_size = params.ring_size > 0 ? params.ring_size : (size_t) 64*1024*1024;
+    p.ring_n = (int32_t) std::max<size_t>(1, ring_size/p.ring_slot);
+    p.ring   = p.alloc(host_buft, (size_t) p.ring_n*p.ring_slot);
+    if (p.ring == nullptr) {
+        fail(p.error);
+        return;
+    }
+
+    // exactness check before anything else is pinned: the first and last expert of every cached tensor, read through
+    // the source, must equal the bytes in the memory map, else the source is not used
+    // (MARIAN_MOE_SOURCE_VERIFY=0 skips it, =all also checks every read during the run)
+    if (verify_load) {
+        for (size_t il = 0; il < layers.size(); ++il) {
+            if (layers[il].empty()) {
+                continue;
+            }
+            p.il = (int32_t) il;
+            for (int32_t e : { (int32_t) 0, (int32_t) layers[il][0].host->ne[2] - 1 }) {
+                const auto & ts = layers[il];
+                for (size_t k = 0; k < ts.size(); ++k) {
+                    p.submit(nullptr, ts[k], e, p.ring + p.region_off[il][k], nullptr, 0, -1, -1);
+                }
+                p.drain(nullptr);
+            }
+        }
+        if (p.n_mismatch > 0 || p.n_fail > 0) {
+            fail(format("the verification read %zu expert tensors that differ from the memory map and %zu that failed", p.n_mismatch, p.n_fail));
+            return;
+        }
+        p.bytes_read = 0;
+        p.il = -1;
+    }
+
+    if (p.type == LLAMA_MOE_MISS_SOURCE_TIER && params.tier_size > 0) {
+        size_t total = 0;
+        for (size_t b : group_bytes) {
+            total += b;
+        }
+        const size_t max_chunk = std::min<size_t>(ggml_backend_buft_get_max_size(host_buft), (size_t) 1024*1024*1024);
+        p.tiers.resize(n_group);
+        for (size_t g = 0; g < n_group; ++g) {
+            impl::tier & t = p.tiers[g];
+            t.slot_bytes = group_slot[g];
+            if (t.slot_bytes == 0) {
+                continue;
+            }
+            // the tier is split among the groups like the VRAM budget, by the size of their experts
+            const size_t share = (size_t) ((double) params.tier_size*group_bytes[g]/total);
+            t.n_slots = (int32_t) std::min<size_t>(share/t.slot_bytes, (size_t) group_layers[g]*n_expert);
+            const int32_t per_chunk = (int32_t) std::max<size_t>(1, max_chunk/t.slot_bytes);
+            for (int32_t s0 = 0; s0 < t.n_slots; s0 += per_chunk) {
+                const int32_t n = std::min(per_chunk, t.n_slots - s0);
+                uint8_t * base = p.alloc(host_buft, (size_t) n*t.slot_bytes);
+                if (base == nullptr) {
+                    fail(p.error);
+                    return;
+                }
+                for (int32_t s = 0; s < n; ++s) {
+                    t.base.push_back(base + (size_t) s*t.slot_bytes);
+                }
+            }
+            t.key.assign(t.n_slots, -1);
+            t.ref.assign(t.n_slots, 0);
+            t.busy.assign(t.n_slots, 0);
+        }
+        p.tier_slot.assign(layers.size(), std::vector<int32_t>());
+        p.count.assign(layers.size(), std::vector<uint16_t>());
+        p.n_decode.assign(layers.size(), 0);
+        for (size_t il = 0; il < layers.size(); ++il) {
+            if (group_of[il] >= 0) {
+                p.tier_slot[il].assign(n_expert, -1);
+                p.count[il].assign(n_expert, 0);
+            }
+        }
+    } else if (p.type == LLAMA_MOE_MISS_SOURCE_TIER) {
+        LLAMA_LOG_WARN("llama_moe_source: the tier has no size (--moe-tier-mib), only the staging ring is used\n");
+    }
+
+    bool all_direct = true;
+    for (const auto & f : p.files) {
+        all_direct = all_direct && f.direct;
+    }
+    std::string tier_desc = "no tier";
+    if (!p.tiers.empty()) {
+        tier_desc = "tier slots per group:";
+        for (const auto & t : p.tiers) {
+            tier_desc += format(" %d", t.n_slots);
+        }
+    }
+    LLAMA_LOG_WARN("llama_moe_source: Marian P3 (experimental) %s: ring %d x %.2f MiB, %s, %.2f MiB pinned%s, sector %llu, %s reads%s\n",
+        p.type == LLAMA_MOE_MISS_SOURCE_TIER ? "tier" : "ring", p.ring_n, p.ring_slot/1024.0/1024.0, tier_desc.c_str(),
+        p.pinned_bytes/1024.0/1024.0, p.pageable_bytes > 0 ? format(" (+%.2f MiB PAGEABLE: pinning failed)", p.pageable_bytes/1024.0/1024.0).c_str() : "",
+        (unsigned long long) p.sector, all_direct ? "unbuffered" : "SOME BUFFERED", verify_load ? ", verified against the memory map" : "");
+}
+
+llama_moe_source::~llama_moe_source() {
+    log_stats();
+}
+
+const std::string & llama_moe_source::error() const {
+    return pimpl->error;
+}
+
+void llama_moe_source::begin(int32_t il, bool decode, const int32_t * uniq, size_t n_uniq) {
+    impl & p = *pimpl;
+    p.il        = il;
+    p.decode    = decode;
+    p.ring_next = 0;
+    p.step_read = 0;
+    p.gen++;
+    if (decode && !p.tiers.empty() && p.group_of[il] >= 0) {
+        auto & c = p.count[il];
+        for (size_t i = 0; i < n_uniq; ++i) {
+            if (c[uniq[i]] < UINT16_MAX) {
+                c[uniq[i]]++;
+            }
+        }
+        if (++p.n_decode[il] >= moe_source_decay_period) {
+            for (auto & x : c) {
+                x >>= 1;
+            }
+            p.n_decode[il] = 0;
+        }
+    }
+}
+
+char llama_moe_source::fill(ggml_backend_t backend, int32_t e, int32_t s) {
+    impl & p = *pimpl;
+    const int32_t g = p.group_of[p.il];
+    GGML_ASSERT(g >= 0);
+
+    if (!p.tiers.empty() && p.tiers[g].n_slots > 0) {
+        impl::tier & t = p.tiers[g];
+        const int32_t ts = p.tier_slot[p.il][e];
+        if (ts >= 0) {
+            // a tier hit: upload from the pinned slot
+            const auto & tensors = p.layers[p.il];
+            for (size_t k = 0; k < tensors.size(); ++k) {
+                const uint64_t off = tensors[k].offset + (uint64_t) e*tensors[k].nb2;
+                ggml_backend_tensor_set_async(backend, tensors[k].bank, t.base[ts] + p.region_off[p.il][k] + off % p.sector,
+                    (size_t) s*tensors[k].nb2, tensors[k].nb2);
+            }
+            t.busy[ts] = p.gen;
+            if (p.decode) {
+                t.ref[ts] = 1;
+            }
+            p.n_tier++;
+            return 't';
+        }
+        if (p.decode) {
+            const int32_t v = p.victim(t, e);
+            if (v >= 0) {
+                p.invalidate(g, v);
+                t.key[v]            = p.il*p.n_expert + e;
+                t.ref[v]            = 1;
+                t.busy[v]           = p.gen;
+                p.tier_slot[p.il][e] = v;
+                p.read_expert(backend, e, s, t.base[v], g, v);
+                p.n_admit++;
+                return 'a';
+            }
+        }
+    }
+
+    // through the staging ring; when it is full, the uploads from it must finish before it is reused
+    if (p.ring_next == p.ring_n) {
+        p.drain(backend);
+        ggml_backend_synchronize(backend);
+        p.ring_next = 0;
+        p.gen++;
+        p.n_wrap++;
+    }
+    p.read_expert(backend, e, s, p.ring + (size_t) p.ring_next++*p.ring_slot, -1, -1);
+    p.n_ring++;
+    return 'r';
+}
+
+void llama_moe_source::end(ggml_backend_t backend) {
+    pimpl->drain(backend);
+}
+
+size_t llama_moe_source::step_bytes_read() const {
+    return pimpl->step_read;
+}
+
+void llama_moe_source::log_stats() const {
+    const impl & p = *pimpl;
+    const size_t n = p.n_tier + p.n_admit + p.n_ring;
+    if (n == 0) {
+        return;
+    }
+    LLAMA_LOG_INFO("llama_moe_source: %zu misses: %zu from the tier (%.1f%%), %zu admitted, %zu through the ring, %.2f GiB read, "
+        "%zu ring wraps, %zu failed reads, %zu mismatches\n", n, p.n_tier, 100.0*p.n_tier/n, p.n_admit, p.n_ring,
+        p.bytes_read/1024.0/1024.0/1024.0, p.n_wrap, p.n_fail, p.n_mismatch);
+}
