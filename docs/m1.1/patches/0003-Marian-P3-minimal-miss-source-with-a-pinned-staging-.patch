--- /dev/null
+++ b/src/llama-moe-source.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Marian P3 (minimal): serves the misses of the MoE cache from pinned host memory instead of the memory-mapped GGUF.
+//   ring: unbuffered reads (Windows: FILE_FLAG_NO_BUFFERING with overlapped I/O; Linux: O_DIRECT), offsets and lengths
+//         rounded out to the queried sector size, into a pinned staging ring; the expert is uploaded from there
+//   tier: the ring plus a bounded pinned RAM tier; an expert missed in a decode step is admitted when it was selected
+//         more often (decayed counts) than the CLOCK victim it would replace; larger steps (prefill) only read the tier
+// Only the source of the bytes changes: the bytes of the GGUF at the tensor's offsets, which are the bytes the memory map
+// holds, reach the same bank slots, and the same kernels read them. A failed read falls back to the host tensor for that
+// expert, with a counter and a warning.
+
+enum llama_moe_miss_source_type {
+    LLAMA_MOE_MISS_SOURCE_MMAP = 0, // upstream: upload from the host tensor (usually the memory map)
+    LLAMA_MOE_MISS_SOURCE_RING = 1,
+    LLAMA_MOE_MISS_SOURCE_TIER = 2,
+};
+
+struct llama_moe_source_params {
+    int32_t type      = LLAMA_MOE_MISS_SOURCE_MMAP;
+    size_t  ring_size = 0; // pinned staging ring in bytes, 0 = 64 MiB
+    size_t  tier_size = 0; // pinned RAM tier in bytes (type TIER)
+};
+
+// one expert tensor of a cached layer: where it is in its GGUF file and the bank its experts are uploaded to
+struct llama_moe_source_tensor {
+    int32_t             file;   // index into the file list
+    uint64_t            offset; // file offset of expert 0
+    uint64_t            nb2;    // bytes per expert
+    ggml_tensor       * bank;   // device bank of the layer's group, slot s at s*nb2
+    const ggml_tensor * host;   // the host tensor (memory map), used for verification and as the fallback
+};
+
+class llama_moe_source {
+public:
+    // layers: [n_layer] the expert tensors of each cached layer in bank order, empty if the layer is not cached
+    // group_of: [n_layer] the cache group of each layer, -1 if not cached; group_bytes: [n_group] host bytes of each group
+    // never throws: if the source cannot be set up (or its load-time check against the memory map fails), error() says
+    // why, the object holds no pinned memory, and the caller drops it and keeps the upstream uploads
+    llama_moe_source(const llama_moe_source_params & params, ggml_backend_buffer_type_t host_buft,
+                     const std::vector<std::string> & files,
+                     const std::vector<std::vector<llama_moe_source_tensor>> & layers,
+                     const std::vector<int32_t> & group_of, const std::vector<size_t> & group_bytes, int32_t n_expert);
+    ~llama_moe_source();
+
+    // empty if the source is usable
+    const std::string & error() const;
+
+    // start of the fills of layer il, right after the caller synchronized the backend, so every staging buffer is free
+    // decode: a small step (single-token decode), whose distinct selections uniq update the counts and may admit experts
+    // into the tier; other steps only read the tier, so a long prefill cannot evict the decode-hot set
+    void begin(int32_t il, bool decode, const int32_t * uniq, size_t n_uniq);
+
+    // upload expert e of layer il into slot s of its banks
+    // returns where the bytes come from: 't' tier, 'a' read and admitted into the tier, 'r' read through the ring
+    // (a read that fails later is uploaded from the host tensor instead, and counted)
+    char fill(ggml_backend_t backend, int32_t e, int32_t s);
+
+    // complete the reads of this step and issue their uploads, which finish before the caller's next synchronize
+    void end(ggml_backend_t backend);
+
+    // bytes read from the files since begin()
+    size_t step_bytes_read() const;
+
+    void log_stats() const;
+
+private:
+    struct impl;
+    std::unique_ptr<impl> pimpl;
+};
