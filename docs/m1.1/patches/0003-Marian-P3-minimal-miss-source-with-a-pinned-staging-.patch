+bool llama_model::weight_file_range(const ggml_tensor * t, std::string & path, size_t & offset) const {
+    if (t == nullptr || t->data == nullptr) {
+        return false;
+    }
+    // the memory maps cover whole files, so a tensor read through one sits at its address minus the map's base
+    const uint8_t * p = (const uint8_t *) t->data;
+    for (size_t i = 0; i < pimpl->mappings.size() && i < pimpl->mapping_paths.size(); ++i) {
+        const uint8_t * base = (const uint8_t *) pimpl->mappings[i]->addr();
+        if (base != nullptr && !pimpl->mapping_paths[i].empty() && p >= base && p + ggml_nbytes(t) <= base + pimpl->mappings[i]->size()) {
+            path   = pimpl->mapping_paths[i];
+            offset = (size_t) (p - base);
+            return true;
+        }
+    }
+    return false;
+}
+
 float llama_model::get_rope_freq_base (const llama_cparams & cparams, int il) const {
