 src/llama-moe-cache.cpp  |  39 ++++++
 src/llama-moe-cache.h    |  12 ++
 src/llama-moe-source.cpp | 269 +++++++++++++++++++++++++++++++++++----
 src/llama-moe-source.h   |  15 +++
 6 files changed, 369 insertions(+), 31 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 91966f84..5ede13d5 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2820,12 +2820,18 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
     const int64_t n_expert    = src->ne[2];
     const size_t  expert_size = src->nb[2];
 
+    // Marian 0008: with a P3 miss source (--moe-miss-source ring or tier) the experts not copied from the cache are uploaded
+    // from the pinned tier or read unbuffered through the staging ring, never from the memory map; the same bytes to the
+    // same offsets of dst as below, all of it queued on the backend's stream before the split's compute
+    const bool p3 = lctx->moe_cache && lctx->moe_cache->has_miss_source(backend, src);
+
     FILE * trace = llama_moe_trace_file();
+    FILE * trace_fills = p3 ? llama_moe_trace_fills_file() : nullptr;
     llama_moe_ids_writer * trace_ids = llama_moe_trace_ids();
-    const int64_t t0 = trace || trace_ids ? llama_moe_trace_us() : 0;
+    const int64_t t0 = trace || trace_ids || trace_fills ? llama_moe_trace_us() : 0;
     int64_t t1 = t0;
     size_t n_cached = 0; // experts copied device-to-device from the MoE cache
-    size_t bytes_up = 0; // bytes uploaded from host memory
+    size_t bytes_up = 0; // bytes uploaded from host memory (0008: from the P3 source)
 
     if (ids != st.ids || (int64_t) st.used.size() != n_expert) {
         st.ids_data.resize(ggml_nbytes(ids)/sizeof(int32_t));
@@ -2853,6 +2859,25 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         }
     }
 
+    // upload experts [e0, e0 + n) and pad bytes of expert e0 + n from the host tensor, or (0008) from the P3 source
+    st.fill_e.clear();
+    st.fill_src.clear();
+    auto upload = [&](int64_t e0, int64_t n, size_t pad) {
+        const size_t offset = e0*expert_size;
+        const size_t size   = n*expert_size + pad;
+        if (p3) {
+            const size_t k = st.fill_src.size();
+            st.fill_src.resize(k + n);
+            lctx->moe_cache->upload_experts(backend, src, dst, e0, n, pad, st.fill_src.data() + k);
+            for (int64_t i = 0; i < n; ++i) {
+                st.fill_e.push_back((int32_t) (e0 + i));
+            }
+        } else {
+            ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + offset, offset, size);
+        }
+        bytes_up += size;
+    };
+
     // group consecutive experts and copy them together
     for (int64_t first = 0; first < n_expert; ) {
         if (!st.used[first]) {
@@ -2873,8 +2898,7 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
                 continue;
             }
             if (next < e) {
-                ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + next*expert_size, next*expert_size, (e - next)*expert_size);
-                bytes_up += (e - next)*expert_size;
+                upload(next, e - next, 0);
             }
             n_cached += n;
             e   += n;
@@ -2882,20 +2906,25 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         }
 
         // copy a bit extra to ensure there are no NaNs in the padding of the last expert, this is necessary for MMQ in the CUDA backend
-        const size_t offset  = next*expert_size;
         const size_t padding = last < n_expert - 1 ? std::min<size_t>(expert_size, 512) : 0;
         const size_t size    = (last + 1 - next)*expert_size + padding;
         if (size > 0) {
-            ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + offset, offset, size);
-            bytes_up += size;
+            upload(next, last + 1 - next, padding);
         }
 
         first = last + 1;
     }
 
-    if (trace) {
-        int il = -1;
+    if (p3) {
+        // complete the reads and queue their uploads before the split's compute
+        lctx->moe_cache->upload_experts_end(backend);
+    }
+
+    int il = -1;
+    if (trace || trace_fills) {
         std::sscanf(src->name, "blk.%d.", &il);
+    }
+    if (trace) {
         const size_t n_used = std::count(st.used.begin(), st.used.end(), true);
         const int64_t t2 = llama_moe_trace_us();
         // n_ids = selections in the batch; uniq = distinct experts used; uniq_hits = of those, copied from the cache
@@ -2903,6 +2932,20 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
             n_used, n_cached, n_used - std::min(n_used, n_cached), bytes_up, (long long) (t1 - t0), (long long) (t2 - t1));
     }
 
+    if (trace_fills) {
+        // Marian 0008: one L line per expert tensor uploaded from the P3 source, joined to this copy's L line by (t_us, layer)
+        for (size_t i = 0; i < st.fill_e.size(); ++i) {
+            std::fprintf(trace_fills, "L,%lld,%d,%lld,%d,-1,%c,%zu\n", (long long) t0, il, (long long) ggml_nelements(ids),
+                st.fill_e[i], st.fill_src[i], expert_size);
+        }
+        static size_t n_fill_lines = 0;
+        n_fill_lines += st.fill_e.size();
+        if (n_fill_lines >= 4096) {
+            n_fill_lines = 0;
+            std::fflush(trace_fills); // servers are usually killed, so do not rely on the atexit flush
+        }
+    }
+
     return true;
 }
 
