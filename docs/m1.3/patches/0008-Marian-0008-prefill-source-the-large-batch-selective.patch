         return n;
     }
 
+    // Marian 0008: the large-batch selective copy takes its uploads from the P3 source
+    bool has_miss_source(ggml_backend_t backend, const ggml_tensor * w) const {
+        if (!source) {
+            return false;
+        }
+        const auto it = bindings.find(w);
+        if (it == bindings.end()) {
+            return false;
+        }
+        return backend == devices[groups[layers[it->second.il].ig].id].backend;
+    }
+
+    void upload_experts(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t e0, int64_t n, size_t pad, char * src) {
+        const auto it = bindings.find(w);
+        GGML_ASSERT(source && it != bindings.end());
+        GGML_ASSERT(dst->nb[2] == w->nb[2] && dst->ne[2] == w->ne[2]);
+        source->copy(backend, it->second.il, it->second.ip, dst, e0, n, pad, src);
+    }
+
+    void upload_experts_end(ggml_backend_t backend) {
+        if (source) {
+            source->copy_end(backend);
+        }
+    }
+
     bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {
         const auto it = layer_of.find(src);
         if (it == layer_of.end()) {
@@ -898,6 +925,18 @@ int64_t llama_moe_cache::copy_experts(ggml_backend_t backend, const ggml_tensor
     return pimpl->copy_experts(backend, w, dst, e, last);
 }
 
+bool llama_moe_cache::has_miss_source(ggml_backend_t backend, const ggml_tensor * w) const {
+    return pimpl->has_miss_source(backend, w);
+}
+
+void llama_moe_cache::upload_experts(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t e0, int64_t n, size_t pad, char * src) {
+    pimpl->upload_experts(backend, w, dst, e0, n, pad, src);
+}
+
+void llama_moe_cache::upload_experts_end(ggml_backend_t backend) {
+    pimpl->upload_experts_end(backend);
+}
